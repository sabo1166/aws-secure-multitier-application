# Copy to .env for local development. .env is git-ignored. Placeholders only: never commit real values.

APP_ENV=development
# Local development uses SQLite. Leave DATABASE_URL as is to test without any AWS resources.
DATABASE_URL=sqlite:///./sole_atelier.db
# Generate a real value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-secret
# Set to true only when the site is served over HTTPS (browsers drop Secure cookies on plain HTTP).
SESSION_HTTPS_ONLY=false

# --- Amazon RDS MySQL (AWS deployment; see docs/rds-setup-guide.md) ---
# Leave DATABASE_URL empty and set these instead. The app connects as a dedicated low-privilege user.
# DATABASE_URL=
# DB_HOST=<rds-endpoint-hostname>
# DB_PORT=3306
# DB_NAME=sole_atelier
# DB_USER=sole_app
# Either give the password directly (local testing against MySQL only)...
# DB_PASSWORD=<app-user-password>
# ...or, on AWS, name a Secrets Manager secret holding {"username": "...", "password": "..."}:
# DB_SECRET_ARN=<secret-arn>
# Optional: read the session-signing key from Secrets Manager ({"session_secret": "..."}) instead of SESSION_SECRET,
# so all instances share one key without it appearing in user data:
# SESSION_SECRET_ARN=<secret-arn>
# AWS_REGION=<region>
# Path to the RDS CA bundle (global-bundle.pem) to verify the TLS connection:
# DB_SSL_CA=/opt/sole-atelier/global-bundle.pem
